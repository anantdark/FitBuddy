<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent glass chip for water widget quick-adds. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:endColor="#33FFFFFF"
        android:startColor="#88FFFFFF"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#A6FFFFFF" />
    <corners android:radius="14dp" />
</shape>
