<?xml version="1.0" encoding="utf-8"?><!--
   Cloud Auto Backup is off via android:allowBackup="false". Exclude all domains here so
   Android 12+ cloud restore / extraction also stays empty. Device-to-device transfer is
   excluded for the same reason — supported backups are local JSON + opt-in MongoDB only.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
