<?xml version="1.0" encoding="utf-8"?><!--
   Default cloud + device-transfer backup (empty cloud-backup = include all).

   Keep AI settings (shared_prefs/app_settings.preferences_pb) in the default set so
   reinstall/device setup restores API keys with the Room profile. See SettingsDataStore.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Empty = platform default (databases + sharedpref + files). -->
    </cloud-backup>
    <!-- No device-transfer section: D2D uses the same cloud-backup defaults. -->
</data-extraction-rules>