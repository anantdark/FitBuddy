<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_describe_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_describe_log_label"
        android:padding="12dp"
        android:src="@drawable/ic_widget_sparkle"
        android:tint="#465762" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:text="@string/widget_describe_log_label"
        android:textColor="#171D1B"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_describe_preview_send"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_widget_send"
        android:tint="#FFFFFF" />
</LinearLayout>
